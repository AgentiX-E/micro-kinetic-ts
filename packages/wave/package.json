{
  "name": "@agentix-e/micro-kinetic-wave",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Wave kinetic equation-based alert cascade propagation — applying Deng Yu's wave turbulence theory to AIOps alert propagation",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist coverage .tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agentix-e/micro-kinetic-core": "workspace:^",
    "numpy-ts": "^1.4.0"
  },
  "peerDependencies": {
    "numpy-ts": "^1.4.0"
  },
  "devDependencies": {
    "@agentix-e/micro-kinetic-core": "workspace:^",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "license": "MIT"
}
