{
  "name": "@agentix-e/micro-kinetic-optimize",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Adaptive configuration optimization via LLM-guided Bayesian inference for microservice RCA",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@agentix-e/micro-kinetic-core": "workspace:*",
    "@agentix-e/micro-kinetic-tree": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
