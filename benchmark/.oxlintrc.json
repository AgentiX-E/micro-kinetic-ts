{
  "rules": {
    "no-console": "warn",
    "no-debugger": "error",
    "no-unused-vars": "warn",
    "prefer-const": "error",
    "no-var": "error",
    "eqeqeq": ["error", "always"]
  },
  "overrides": [
    {
      "files": ["benchmarks/**/*.ts"],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
