# ── Embedding API Configuration ───────────────────────────
# Vendor-agnostic: any OpenAI-compatible embedding API works.
# Uncomment and fill in for your chosen provider.

# Zhipu GLM embedding-3 (recommended, 2048-dim)
# ZHIPU_API_KEY=your_api_key_here
# ZHIPU_EMBEDDING_MODEL=embedding-3
# ZHIPU_EMBEDDING_DIMENSION=2048

# DeepSeek embedding
# DEEPSEEK_API_KEY=your_api_key_here
# DEEPSEEK_EMBEDDING_MODEL=deepseek-embedding
# DEEPSEEK_EMBEDDING_DIMENSION=1024

# OpenAI embedding
# OPENAI_API_KEY=your_api_key_here
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_EMBEDDING_DIMENSION=1536

# Custom provider template:
# CUSTOM_EMBEDDING_ENDPOINT=https://api.example.com/v1/embeddings
# CUSTOM_EMBEDDING_MODEL=custom-model
# CUSTOM_EMBEDDING_DIMENSION=768
# CUSTOM_API_KEY=your_api_key_here

# ── LLM Configuration ─────────────────────────────────────
# Used by SemanticAlignmentProvider for LLM fallback alignment
# DEEPSEEK_API_KEY=your_api_key_here
# DEEPSEEK_LLM_MODEL=deepseek-chat
