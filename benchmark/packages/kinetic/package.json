{
  "name": "@agentix-e/micro-kinetic",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "AIOps-Kinetic: Applying Deng Yu's Fields Medal-winning kinetic theory to microservice root cause analysis, alert denoising, and fault propagation modeling",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "bin"],
  "bin": {
    "micro-kinetic": "./bin/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist coverage .tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agentix-e/micro-kinetic-core": "workspace:^",
    "@agentix-e/micro-kinetic-tree": "workspace:^",
    "@agentix-e/micro-kinetic-cutting": "workspace:^",
    "@agentix-e/micro-kinetic-noise": "workspace:^",
    "@agentix-e/micro-kinetic-scaling": "workspace:^",
    "@agentix-e/micro-kinetic-wave": "workspace:^",
    "commander": "^12.0.0",
    "mathjs": "^13.0.0"
  },
  "optionalDependencies": {
    "onnxruntime-node": "^1.20.0"
  },
  "peerDependencies": {
    "numpy-ts": "^1.4.0"
  },
  "devDependencies": {
    "@agentix-e/micro-kinetic-core": "workspace:^",
    "@agentix-e/micro-kinetic-tree": "workspace:^",
    "@agentix-e/micro-kinetic-cutting": "workspace:^",
    "@agentix-e/micro-kinetic-noise": "workspace:^",
    "@agentix-e/micro-kinetic-scaling": "workspace:^",
    "@agentix-e/micro-kinetic-wave": "workspace:^",
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "license": "MIT"
}
