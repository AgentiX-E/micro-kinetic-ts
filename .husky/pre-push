#!/usr/bin/env sh
# ── Pre-Push Guard ──────────────────────────────────────────
# Runs the same checks as CI before allowing git push.
# If any step fails the push is aborted.
#
# 1. lint            — Biome/ESLint (0 warnings, 0 errors)
# 2. format          — Prettier (all files matched)
# 3. typecheck       — tsc --noEmit across all projects
# 4. test            — vitest run across all packages
# 5. benchmark-smoke — parse tests for benchmark scripts
#
# Override with: git push --no-verify  (emergency only)
# ─────────────────────────────────────────────────────────────

set -e

GREEN='\033[0;32m'
RED='\033[0;31m'
NC='\033[0m'

pass()  { echo "${GREEN}✓${NC} $1"; }
fail()  { echo "${RED}✗${NC} $1"; exit 1; }

echo ""
echo "═══════════════════════════════════════════════════════"
echo "  Pre-Push Guard — CI-Equivalent Verification"
echo "═══════════════════════════════════════════════════════"
echo ""

# ── 1. Lint ──
echo -n "  [1/5] pnpm lint … "
output=$(pnpm lint 2>&1)
if echo "$output" | grep -q "Found 0 warnings and 0 errors"; then
  pass "lint"
else
  echo ""
  echo "  $output" | tail -5
  fail "lint"
fi

# ── 2. Format Check ──
echo -n "  [2/5] pnpm format:check … "
output=$(pnpm format:check 2>&1)
if echo "$output" | grep -q "All matched files use Prettier code style"; then
  pass "format:check"
else
  echo ""
  echo "  $output" | tail -5
  fail "format:check"
fi

# ── 3. Typecheck ──
echo -n "  [3/5] pnpm typecheck … "
if pnpm typecheck > /dev/null 2>&1; then
  pass "typecheck"
else
  fail "typecheck"
fi

# ── 4. Tests ──
echo -n "  [4/5] pnpm test … "
output=$(pnpm test 2>&1)
if [ $? -eq 0 ]; then
  echo "$output" | grep -E "Tests\s+[0-9]+\s+passed" | head -1 | xargs echo "$GREEN✓$NC"
else
  echo ""
  echo "  $output" | tail -5
  fail "tests"
fi

# ── 5. Benchmark Script Smoke Check ──
echo -n "  [5/5] benchmark smoke check … "
failed=0
for script in benchmarks/src/run-ablation.ts benchmarks/src/run-rcaeval.ts benchmarks/src/optimize-all.ts; do
  if [ ! -f "$script" ]; then continue; fi
  output=$(BENCHMARK_USE_TFIDF=1 node --import tsx/esm "$script" --data-dir /nonexistent --suite re1 2>&1) || true
  if echo "$output" | grep -qE "^(Error|ReferenceError|SyntaxError|TypeError)"; then
    echo ""
    echo "  $script: $output" | head -3
    failed=$((failed + 1))
  fi
done
if [ $failed -eq 0 ]; then
  pass "benchmark smoke"
else
  fail "benchmark smoke — $failed script(s) have runtime errors"
fi

echo ""
echo "═══════════════════════════════════════════════════════"
echo "  All checks passed — pushing …"
echo "═══════════════════════════════════════════════════════"
echo ""
